{
  "name": "@lvce-editor/panel-worker-monorepo",
  "version": "0.0.0-dev",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "node packages/build/src/build.ts",
    "build:static": "node packages/build/src/build-static.ts",
    "build:watch": "node packages/build/src/build-watch.ts",
    "dev": "node packages/build/src/dev.ts",
    "e2e": "npm run e2e --workspace=packages/e2e",
    "format": "prettier --write .",
    "lint": "eslint . && prettier --check . && knip --no-config-hints",
    "measure": "node --experimental-strip-types packages/build/src/measureMemory.ts",
    "measure:visible": "node --experimental-strip-types packages/build/src/measureMemory.ts --no-headless",
    "test": "npm test --workspaces --if-present",
    "type-check": "tsc -b"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "printWidth": 150
  },
  "devDependencies": {
    "@lvce-editor/eslint-config": "^18.14.2",
    "eslint": "^10.12.0",
    "knip": "^6.40.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3"
  }
}
